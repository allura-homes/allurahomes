# Database (Neon Postgres)
DATABASE_URL=postgresql://user:password@host/database

# Guesty Open API (existing - for listings, availability, calendar)
# Scope: open-api
GUESTY_CLIENT_ID=your_open_api_client_id
GUESTY_CLIENT_SECRET=your_open_api_client_secret

# Guesty Booking Engine API (NEW - for quotes and reservations)
# Create a new API instance in Guesty Marketplace:
# https://app.guesty.com/marketplace
# Look for "Booking Engine API" and create credentials
GUESTY_BE_CLIENT_ID=your_booking_engine_client_id
GUESTY_BE_CLIENT_SECRET=your_booking_engine_client_secret

# Guesty Booking URL (legacy fallback - optional)
NEXT_PUBLIC_GUESTY_BOOKING_URL=https://reservations.allurahomes.com

# Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=your_bcrypt_hash

# Next.js
NEXT_PUBLIC_SITE_URL=https://www.allurahomes.com
